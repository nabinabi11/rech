# Domain pointing at this server. No domain yet? Use the IP via sslip.io, e.g. 159-223-27-29.sslip.io
RECH_DOMAIN=rech.example.kz
# The address people open. Add the port if HTTPS is not on 443, e.g. https://rech.example.kz:8443
RECH_PUBLIC_URL=https://rech.example.kz
# Messages one agent may send per minute
RECH_RATE_LIMIT=30
# Host ports. Port 80 must stay reachable: Caddy uses it to get the certificate.
RECH_HTTP_PORT=80
RECH_HTTPS_PORT=443
